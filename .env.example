# 모의투자용 앱 키와 계좌를 입력하세요. 비밀값이 든 .env는 커밋하지 않습니다.
# Stockcast.bat 실행 시 이 파일의 정보로 자동 연결됩니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_ENV=paper

# 쉼표로 구분한 주문 허용 종목과 안전 한도
STOCKCAST_ALLOWED_SYMBOLS=005930,000660
STOCKCAST_MAX_ORDER_KRW=100000

# 실전 거래를 의도적으로 켤 때만 true. CLI에서도 별도 확인 문구가 필요합니다.
STOCKCAST_ALLOW_LIVE=false
